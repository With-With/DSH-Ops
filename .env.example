# DSH-Ops 环境变量样例（复制为 .env 后按需修改；.env 不入库）

# ── Django ─────────────────────────────
DSHOPS_SECRET_KEY=change-me-in-production
DSHOPS_DEBUG=1

# 数据库：不设则用 SQLite；设 mysql 读下面五个变量
#DSHOPS_DB=mysql
#DB_NAME=dsh_ops
#DB_USER=root
#DB_PASSWORD=
#DB_HOST=127.0.0.1
#DB_PORT=3306

# ── DSH 平台运行时 ─────────────────────
# 平台 DSH_HOME 覆盖（默认 <仓库>/agent/home）
#DSHOPS_DSH_HOME=D:\AI-soft\AI-TESTHUB\DSH-Ops\agent\home

# ── AI 配置中心（P3 启用，密钥落库加密）──
#DSHOPS_FERNET_KEY=
